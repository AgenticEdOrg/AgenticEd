# Copy this file to .env and fill in the keys you have. Never commit .env.
# If a provider fails, the next key that is set answers at once. Order: Gemini, Groq, Mistral, OpenRouter, Anthropic.
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Free Mistral key (Experiment plan): https://console.mistral.ai/
MISTRAL_API_KEY=
# Free OpenRouter key (":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: choose the model and a backup model ("provider:model")
# AGENTICED_MODEL=gemini:gemini-3.6-flash
# AGENTICED_FALLBACK_MODEL=gemini-3.8-flash

# Optional tuning
# AGENTICED_MIN_SIMILARITY=0.30     # below this, refuse without calling the LLM
# AGENTICED_RATE_LIMIT=10           # questions per minute per visitor (server.py)
# AGENTICED_ALLOWED_ORIGINS=https://agenticed.org,https://www.agenticed.org
