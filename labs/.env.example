# Copy to labs/.env and fill in ONE key. Never commit .env.
# In Google Colab, add the same names under Secrets (key icon) instead and enable notebook access.

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: pick a specific model (defaults: openai:gpt-5.4-mini or anthropic:claude-haiku-5-5)
# AGENTICED_MODEL=openai:gpt-5.4-mini

# Optional: any OpenAI-compatible endpoint (Ollama, vLLM, a LiteLLM proxy). Use with AGENTICED_MODEL=openai:<model-name>
# OPENAI_BASE_URL=http://localhost:11434/v1
